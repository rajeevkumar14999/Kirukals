release/

# secrets
.env

# Desktop builds. Installers are ~100MB — GitHub refuses anything over 100MB,
# and a repository is the wrong place for them anyway. Publish them as GitHub
# Releases instead, which is also where the update feed can live.
release/
public/downloads/*.exe
public/downloads/*.blockmap
dist/downloads/

# Fonts are copied out of node_modules by the build, not written by hand.
# Keep them: the app needs them and they are small and licensed to redistribute.
!public/fonts/
electron/google-config.cjs
