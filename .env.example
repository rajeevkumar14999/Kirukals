# Kirukals — server settings
#
# Copy this file to `.env`, paste your two values, and restart the dev server.
# Without them the app runs exactly as it does today: everything stays in the
# browser it was written in.
#
# Both values are safe in a client app. The anon key grants nothing on its own —
# row-level security in Postgres decides what each signed-in user may see.
# The service_role key is NOT one of these. It bypasses all security and
# belongs only in server-side functions.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google sign-in.
# The web client ID is the one you gave Supabase — Google's own button uses it.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# A second client, of type "Desktop app", for the installed version. Its
# secret is not confidential (Google says so); PKCE protects the exchange.
KIRUKALS_GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
KIRUKALS_GOOGLE_DESKTOP_CLIENT_SECRET=your-desktop-client-secret
