{
  "name": "kirukals",
  "productName": "Kirukals",
  "private": true,
  "version": "1.0.4",
  "description": "Write screenplays with industry-standard formatting, and plan the shoot from the same script.",
  "author": "Kirukals",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "vite preview --port 4173 --open",
    "desktop": "electron .",
    "desktop:build": "vite build --base ./ && electron-builder --win -c.directories.output=%TEMP%/kirukals-release",
    "desktop:dir": "vite build --base ./ && electron-builder --win --dir -c.directories.output=%TEMP%/kirukals-release",
    "protect": "node scripts/protect.cjs",
    "desktop:build:protected": "vite build --base ./ && node scripts/protect.cjs && electron-builder --win -c.directories.output=%TEMP%/kirukals-release"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.5.0",
    "oxlint": "^1.75.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.kirukals.app",
    "productName": "Kirukals",
    "copyright": "Copyright © Kirukals",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!dist/downloads/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:4173/downloads/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kirukals",
      "artifactName": "Kirukals-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Kirukals",
        "schemes": [
          "kirukals"
        ]
      }
    ]
  }
}
